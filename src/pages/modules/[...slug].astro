---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const mods = await getCollection('modules');
  return mods.map((m) => ({ params: { slug: m.id.replace(/\/index$/, '') }, props: { m } }));
}
const { m } = Astro.props;
const { Content } = await render(m);
---
<Base title={m.data.title} description={m.data.description}>
  <div class="kicker">Module {m.data.order}</div>
  <h1>{m.data.title}</h1>
  <p class="lede">{m.data.description}</p>
  {m.data.objectives.length > 0 && (
    <section class="objectives" aria-labelledby="objectives">
      <h2 id="objectives">Learning objectives</h2>
      <ul style="margin:0;padding-left:1.2em">{m.data.objectives.map((o) => <li>{o}</li>)}</ul>
    </section>
  )}
  <div class="prose"><Content /></div>
  {m.data.lastReviewed && <p class="meta" style="margin-top:2rem">Last reviewed {m.data.lastReviewed}.</p>}
</Base>
