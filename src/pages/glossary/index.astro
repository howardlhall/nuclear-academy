---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const terms = (await getCollection('glossary')).sort((a, b) => a.data.term.localeCompare(b.data.term));
const rendered = await Promise.all(terms.map(async (t) => ({ t, C: (await render(t)).Content })));
---
<Base title="Glossary" description="Terms of art, defined with their sources.">
  <div class="kicker">Glossary</div>
  <h1>Terms</h1>
  <dl class="prose">
    {rendered.map(({ t, C }) => (
      <>
        <dt id={t.id}>{t.data.term}{t.data.source && <span class="meta"> — {t.data.source}</span>}</dt>
        <dd><C /></dd>
      </>
    ))}
  </dl>
</Base>
