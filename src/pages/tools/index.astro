---
import Base from '../../layouts/Base.astro';
---
<Base title="Tools" description="Instruments that run in your browser.">
  <div class="kicker">Tools</div>
  <h1>Instruments you can explore</h1>
  <p class="lede">Everything runs in your browser; nothing you enter leaves your machine.</p>
  <ul class="list-rule" style="margin-top:2rem">
    <li><span class="date">Tool</span><span><a href="/tools/decay-chain/">Decay-chain calculator</a><br /><span class="meta">Bateman solutions for any chain, with the equations shown.</span></span></li>
    <li><span class="date">Tool</span><span><a href="/tools/nuclide-chart/">Nuclide chart explorer</a><br /><span class="meta">Every ground state from ENSDF, colored by decay mode; click a box to see where it goes.</span></span></li>
    <li><span class="date">Atlas</span><span><a href="/atlas/">Facilities map</a><br /><span class="meta">The civil nuclear fuel cycle, from public data.</span></span></li>
  </ul>
</Base>
